# ─── Savri web booking flow — environment variables ──────────────────────────
# Copy to .env.local for local dev, and set the same in Vercel project settings.
# NONE of these are exposed to the browser (no NEXT_PUBLIC_ prefix) except
# NEXT_PUBLIC_SITE_URL.

# Public site origin, used to build the Cashfree return URL.
NEXT_PUBLIC_SITE_URL=https://savri.co.in

# ─── Firebase Admin (writes bookings to the shared savri-846b3 project) ───────
# Service account with Firestore write access. In Vercel, paste the private key
# with literal \n between lines (the app converts them back to newlines).
FIREBASE_PROJECT_ID=savri-846b3
FIREBASE_CLIENT_EMAIL=your-service-account@savri-846b3.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ─── Cashfree (sandbox for now; flip CASHFREE_ENV=production to go live) ───────
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
# Optional: server-to-server webhook that also confirms bookings if the buyer
# never returns to the callback page. The mobile project already has one
# deployed; point this at a webhook that matches bookings by paymentOrderId.
CASHFREE_WEBHOOK_URL=

# ─── Notifications (STEP 8) ───────────────────────────────────────────────────
# Swap the channel with one line: email (default) or whatsapp.
NOTIFY_CHANNEL=email
NOTIFY_TO_EMAIL=founder@savri.co.in
NOTIFY_FROM_EMAIL=bookings@savri.co.in
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# ─── WhatsApp (later — Meta WhatsApp Cloud API, once verified) ────────────────
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TO=
